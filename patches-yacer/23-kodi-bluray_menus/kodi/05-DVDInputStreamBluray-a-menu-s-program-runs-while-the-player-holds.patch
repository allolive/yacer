From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: allolive <160342668+allolive@users.noreply.github.com>
Date: Wed, 21 Oct 2026 16:02:17 -0400
Subject: [PATCH] DVDInputStreamBluray: a menu's program runs while the player
 holds

libbluray runs an HDMV disc's program - the commands of a menu's
auto-activated button, those a button sends to the graphics controller -
from bd_read_ext, and only once the player has taken every event it
queued: a read returns the next event first and leaves the program
waiting.

At a playlist change the player holds: it stops reading until it has
played what it read before, which on a menu's low-rate background loop
is tens of seconds. A playlist change queues several events, so the
program stopped with them. A menu that draws a blank page as its loop
starts and shows its buttons from an auto-activated button had its
buttons drawn only when the hold ended, and drew the blank page again
when the read reached the end of the next loop, seconds later: a
32-second menu loop showed its buttons for about 3 seconds.

When the player starts holding, the input stream now takes libbluray's
events into a queue of its own until the program has run, and hands
them to the player, in order, wherever it read libbluray's: the next
read, the events of a new stream, a seek. Playback without menus is
unchanged.

Signed-off-by: allolive <160342668+allolive@users.noreply.github.com>
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 66 +++++++++++++++----
 .../DVDInputStreams/DVDInputStreamBluray.h    |  5 ++
 2 files changed, 60 insertions(+), 11 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index a3047add..e99752d5 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -453,7 +453,7 @@ bool CDVDInputStreamBluray::Open()
   m_startWatchTime = std::chrono::steady_clock::now();
 
   // Process any events that occurred during opening
-  while (bd_get_event(m_bd, &m_event))
+  while (NextEvent())
     ProcessEvent();
 
   OpenNextStream();
@@ -508,6 +508,7 @@ void CDVDInputStreamBluray::Close()
   m_clipSpans.clear();
   m_hasMVCExtension = false;
   m_clipStart.clear();
+  m_pending.clear();
 
 #if defined(HAS_UDFREAD)
   // Released last, as the files opened from the volume are closed above
@@ -830,7 +831,7 @@ int CDVDInputStreamBluray::Read(uint8_t* buf, int buf_size)
       if (m_hold == HOLD_ERROR || m_aborted || HasGivenUpReading())
         return -1;
 
-      result = bd_read_ext (m_bd, buf, buf_size, &m_event);
+      result = ReadEvent(buf, buf_size);
 
       if(result < 0)
       {
@@ -856,8 +857,9 @@ int CDVDInputStreamBluray::Read(uint8_t* buf, int buf_size)
             if (m_event.event == BD_EVENT_PLAYITEM && result > 0 && !m_hasMVCExtension)
             {
               HoldClipStart(buf, result);
-              return 0;
+              result = 0;
             }
+            RunProgram();
             return result;
           }
           break;
@@ -880,7 +882,7 @@ int CDVDInputStreamBluray::Read(uint8_t* buf, int buf_size)
       ProcessEvent();
 
       // a clip open can queue its play item behind other events of the same read
-      while(result > 0 && queued && m_hold == HOLD_NONE && bd_get_event(m_bd, &m_event))
+      while(result > 0 && queued && m_hold == HOLD_NONE && NextEvent())
       {
         switch(m_event.event) {
           case BD_EVENT_PLAYITEM:
@@ -888,6 +890,7 @@ int CDVDInputStreamBluray::Read(uint8_t* buf, int buf_size)
             {
               m_hold = HOLD_HELD;
               HoldClipStart(buf, result);
+              RunProgram();
               return 0;
             }
             [[fallthrough]];
@@ -897,6 +900,7 @@ int CDVDInputStreamBluray::Read(uint8_t* buf, int buf_size)
           case BD_EVENT_PLAYLIST:
           case BD_EVENT_STILL_TIME:
             m_hold = HOLD_HELD;
+            RunProgram();
             return result;
 
           default:
@@ -921,7 +925,7 @@ int CDVDInputStreamBluray::Read(uint8_t* buf, int buf_size)
       result = bd_read(m_bd, buf, buf_size);
       if (result > 0)
         m_readErrors = 0;
-      while (bd_get_event(m_bd, &m_event))
+      while (NextEvent())
       {
         if (m_event.event == BD_EVENT_DISCONTINUITY)
           discontinuity = true;
@@ -962,7 +966,7 @@ void CDVDInputStreamBluray::DropClipStartOnJump()
 {
   while (true)
   {
-    if (bd_read_ext(m_bd, nullptr, 0, &m_event) < 0)
+    if (ReadEvent(nullptr, 0) < 0)
     {
       m_hold = HOLD_ERROR;
       break;
@@ -993,6 +997,46 @@ void CDVDInputStreamBluray::DropClipStartOnJump()
     m_hold = HOLD_NONE;
 }
 
+// libbluray runs a disc's program - a menu's auto-activated button, the commands it is waiting to
+// run - only when it is read with no event left for the player. At a playlist change the player
+// stops reading until it has played what it holds, tens of seconds of a menu's loop, and the menu
+// waited for its buttons as long: the events are taken now, for the player to handle in order.
+void CDVDInputStreamBluray::RunProgram()
+{
+  if (!m_navmode)
+    return;
+  for (int i = 0; i < 64; i++)
+  {
+    BD_EVENT event;
+    if (bd_read_ext(m_bd, nullptr, 0, &event) < 0)
+    {
+      m_hold = HOLD_ERROR;
+      return;
+    }
+    if (event.event == BD_EVENT_NONE)
+      return;
+    m_pending.push_back(event);
+  }
+}
+
+bool CDVDInputStreamBluray::NextEvent()
+{
+  if (m_pending.empty())
+    return bd_get_event(m_bd, &m_event);
+  m_event = m_pending.front();
+  m_pending.pop_front();
+  return true;
+}
+
+int CDVDInputStreamBluray::ReadEvent(uint8_t* buf, int size)
+{
+  if (m_pending.empty())
+    return bd_read_ext(m_bd, buf, size, &m_event);
+  m_event = m_pending.front();
+  m_pending.pop_front();
+  return 0;
+}
+
 int CDVDInputStreamBluray::ReadBlocks(uint8_t* buf, int lba, int num_blocks)
 {
   CDVDInputStreamFile* lpstream = m_pstream.get();
@@ -1257,7 +1301,7 @@ bool CDVDInputStreamBluray::PosTime(int ms)
   // a held still belongs to the position the seek left
   if (m_event.event != BD_EVENT_NONE && m_event.event != BD_EVENT_STILL_TIME)
     ProcessEvent();
-  while (bd_get_event(m_bd, &m_event))
+  while (NextEvent())
     ProcessEvent();
   OpenClipSpan();
   RestartExtention();
@@ -1304,7 +1348,7 @@ bool CDVDInputStreamBluray::SeekChapter(int ch)
   // a held still belongs to the position the seek left
   if (m_event.event != BD_EVENT_NONE && m_event.event != BD_EVENT_STILL_TIME)
     ProcessEvent();
-  while (bd_get_event(m_bd, &m_event))
+  while (NextEvent())
     ProcessEvent();
   OpenClipSpan();
   RestartExtention();
@@ -1576,7 +1620,7 @@ CDVDInputStream::ENextStream CDVDInputStreamBluray::NextStream()
   ProcessEvent();
 
   /* process all queued up events */
-  while(bd_get_event(m_bd, &m_event))
+  while (NextEvent())
     ProcessEvent();
 
   // The last read error can be queued with the events of a clip boundary
@@ -1607,7 +1651,7 @@ void CDVDInputStreamBluray::UserInput(bd_vk_key_e vk)
     if (m_event.event != BD_EVENT_NONE)
       ProcessEvent();
     /* process all queued up events */
-    while (bd_get_event(m_bd, &m_event))
+    while (NextEvent())
       ProcessEvent();
   }
 }
@@ -1708,7 +1752,7 @@ void CDVDInputStreamBluray::SkipStill()
     bd_read_skip_still(m_bd);
 
     /* process all queued up events */
-    while (bd_get_event(m_bd, &m_event))
+    while (NextEvent())
       ProcessEvent();
   }
 }
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
index 34c408d3..1202ebee 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
@@ -18,6 +18,7 @@
 
 #include <atomic>
 #include <chrono>
+#include <deque>
 #include <list>
 #include <memory>
 #include <optional>
@@ -302,6 +303,7 @@ protected:
   //! Units libbluray has failed to read since it last returned data
   unsigned int m_readErrors = 0;
   BD_EVENT m_event;
+  std::deque<BD_EVENT> m_pending; //!< events taken from libbluray to let the disc's program run
 #ifdef HAVE_LIBBLURAY_BDJ
   struct bd_argb_buffer_s m_argb;
 #endif
@@ -313,6 +315,9 @@ protected:
     void FreeClipInfo();
     void HoldClipStart(const uint8_t* buf, int size);
     void DropClipStartOnJump();
+    bool NextEvent();
+    int ReadEvent(uint8_t* buf, int size);
+    void RunProgram();
 
     /*!
      * \brief Whether so many reads in a row have failed that the disc is taken to have gone.
