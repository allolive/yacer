-int CStereoDepth::Get(const CFileItem& item)
+CStereoDepth::Depths CStereoDepth::Get(const CFileItem& item)
 {
   std::lock_guard lock(depthLock);
-  const CVariant& all = Depths();
+  const CVariant& all = Stored();
   const std::string key = Key(item);
   if (!all.isMember(key))
-    return 0;
-  return std::clamp(static_cast<int>(all[key].asInteger()), -MAX, MAX);
+    return {};
+  // the picture's depth alone, or both
+  const CVariant& entry = all[key];
+  const auto read = [](const CVariant& depth)
+  { return std::clamp(static_cast<int>(depth.asInteger()), -MAX, MAX); };
+  if (!entry.isObject())
+    return {read(entry), 0};
+  return {read(entry["picture"]), read(entry["subtitles"])};
 }
 
-void CStereoDepth::Set(const CFileItem& item, int depth)
+void CStereoDepth::Set(const CFileItem& item, const Depths& depths)
 {
   std::lock_guard lock(depthLock);
-  CVariant& all = Depths();
+  CVariant& all = Stored();
   const std::string key = Key(item);
-  if (depth == 0)
+  CVariant entry;
+  // the picture's depth alone is written as it always was
+  if (depths.subtitles == 0)
+    entry = depths.picture;
+  else
+  {
+    entry = CVariant(CVariant::VariantTypeObject);
+    entry["picture"] = depths.picture;
+    entry["subtitles"] = depths.subtitles;
+  }
+  if (depths.picture == 0 && depths.subtitles == 0)
   {
     if (!all.isMember(key))
       return;
@@ -103,9 +119,9 @@ void CStereoDepth::Set(const CFileItem& item, int depth)
   }
   else
   {
-    if (all.isMember(key) && all[key].asInteger() == depth)
+    if (all.isMember(key) && all[key] == entry)
       return;
-    all[key] = depth;
+    all[key] = entry;
   }
   Save(all);
 }
